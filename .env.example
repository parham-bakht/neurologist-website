# Docker Compose / PostgreSQL. Use URL-safe characters in these values.
POSTGRES_DB=neurologist
POSTGRES_USER=neurologist
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend runtime (server-only). Keep DATABASE_URL credentials synchronized
# with the PostgreSQL values above and retain the Docker hostname `db`.
DATABASE_URL=postgresql+asyncpg://neurologist:replace-with-a-long-random-password@db:5432/neurologist
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAIN_MANAGER_EMAIL=admin@example.com
MAIN_MANAGER_PASSWORD=replace-with-a-different-strong-password
MAIN_MANAGER_NAME="Main manager"
CORS_ORIGINS=["https://example.com","https://www.example.com"]
ALLOWED_HOSTS=["example.com","www.example.com","localhost","127.0.0.1","backend"]

# Public URL. These NEXT_PUBLIC values are embedded at image build time, so
# rebuild the frontend after changing this value.
PUBLIC_URL=https://example.com

# Optional frontend runtime metadata verification values.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Absolute host directory containing Let's Encrypt certificates on the VPS.
LETSENCRYPT_DIR=/etc/letsencrypt
